{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:pages": "tsx scripts/generate-pages.mjs",
    "build:bootstrap": "vite build --config vite.bootstrap.config.ts",
    "predev": "npm run generate:pages && npm run build:bootstrap",
    "dev": "vite",
    "sync:orderflow": "node scripts/sync-orderflow-assets.mjs",
    "optimize:images": "tsx scripts/optimize-images.mjs",
    "prebuild": "node scripts/sync-orderflow-assets.mjs && npm run optimize:images && npm run generate:pages && npm run build:bootstrap",
    "build": "tsc && vite build",
    "postbuild": "node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test:scroll": "node scripts/repro-scroll-bugs.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "1.1.13"
  }
}
